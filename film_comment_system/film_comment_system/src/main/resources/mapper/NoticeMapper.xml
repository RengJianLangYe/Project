<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.NoticeMapper">
    <!-- 添加公告   -->
    <insert id="inster" parameterType="com.example.entity.Notice">
        insert into notice(title,content,time) values (#{title},#{content},#{time})
    </insert>

    <!-- 更新公告   -->
    <update id="update" parameterType="com.example.entity.Notice">
        update notice
        set
            title = #{title},
            content = #{content},
            time = #{time}
        where id = #{id}
    </update>

    <!-- 根据id删除-->
    <delete id="deleteById" parameterType="int">
        delete from notice where id = #{id}
    </delete>

    <!-- 查询所有公告，自带模糊查询   -->
    <select id="selectAll" resultType="com.example.entity.Notice">
        select * from notice
        <where>
            <if test="title != null and title != ''">
                title like concat('%', #{title}, '%')
            </if>
        </where>
        order by id desc
    </select>

    <!-- 按照id查询   -->
    <select id="selectById"  parameterType="java.lang.Integer" resultType="com.example.entity.Notice">
        select * from notice where id =#{id}
    </select>
</mapper>