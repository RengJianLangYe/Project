<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace 要与对应的 Mapper 接口全限定名一致 -->
<mapper namespace="com.example.mapper.CategoryMapper">

    <!-- 插入分类 -->
    <insert id="insert" parameterType="com.example.entity.Category">
        insert into category (name)
        values (#{name})
    </insert>

    <!-- 更新分类 -->
    <update id="updateById" parameterType="com.example.entity.Category">
        update category
        set name = #{name}
        where id = #{id}
    </update>

    <!-- 删除分类 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        delete from category
        where id = #{id}
    </delete>

    <!-- 查询所有分类，支持按名称模糊查询 -->
    <select id="selectAll" resultType="com.example.entity.Category">
        select * from category
        <where>
            <!-- 如果 name 不为空，则进行模糊匹配 -->
            <if test="name != null and name != ''">
                name like concat('%', #{name}, '%')
            </if>
        </where>
        order by id desc
    </select>

    <!-- 根据id查询   -->
    <select id="selectById" resultType="com.example.entity.Category">
        select * from  category where id =#{id}
    </select>


</mapper>