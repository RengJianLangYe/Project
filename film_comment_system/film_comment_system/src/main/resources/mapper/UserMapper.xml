<?xml version="1.0" encoding="UTF-8"?>
<!-- 声明 DOCTYPE，使用 MyBatis 3 Mapper 的 DTD 文件 -->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 指定该 Mapper 文件对应的 Java 接口类 -->
<mapper namespace="com.example.mapper.UserMapper">

    <!-- 查询所有用户信息 -->
    <select id="selectAll" resultType="com.example.entity.User">
        select * from user
        <!-- 动态查询条件：如果 name 不为 null，则进行模糊匹配 -->
        <where>
            <!-- 使用 if 判断参数是否存在 -->
            <if test="name != null"> and name like concat('%', #{name}, '%')</if>
        </where>
        order by id desc <!-- 按照 id 降序排列 -->
    </select>

    <!-- 插入新用户 -->
    <insert id="insert" parameterType="com.example.entity.User" useGeneratedKeys="true">
        <!-- 插入语句，不显式赋值 id，由数据库自动生成 -->
        insert into user(username, password, name, avatar, role)
        values (#{username}, #{password}, #{name}, #{avatar}, #{role})

        <!-- 如果数据库主键是自增字段，useGeneratedKeys="true" 会自动回填生成的主键 -->
    </insert>

    <!-- 更新用户信息 -->
    <update id="updateById" parameterType="com.example.entity.User">
        <!-- 根据 id 更新用户信息 -->
        update user set
        username = #{username},
        password = #{password},
        name = #{name},
        avatar = #{avatar},
        role = #{role}
        where id = #{id}
    </update>

</mapper>